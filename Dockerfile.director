# The build stage runs on the builder's own platform and cross-compiles:
# building arm64 under QEMU emulation took over 10 minutes.
FROM --platform=$BUILDPLATFORM golang:1.26 AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/director ./cmd/director

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/director /director
USER 65532:65532
ENTRYPOINT ["/director"]
