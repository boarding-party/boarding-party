#!/bin/sh
# MCP stdio launcher: starts the screen streamer once per pod, then execs Playwright MCP.
# Nothing may be written to stdout here; it belongs to the MCP protocol.
live=""
files=""
usage=""
profile=""
device=""
usageonly=""
n=$#
while [ "$n" -gt 0 ]; do
  a="$1"; shift; n=$((n - 1))
  case "$a" in
    --live-url=*) live="${a#--live-url=}" ;;
    --files-url=*) files="${a#--files-url=}" ;;
    --usage-url=*) usage="${a#--usage-url=}" ;;
    --profile-url=*) profile="${a#--profile-url=}" ;;
    --bp-device=*) device="${a#--bp-device=}" ;;
    --usage-only) usageonly=1 ;;
    *) set -- "$@" "$a" ;;
  esac
done

if [ -n "$live" ]; then
  pid=""
  [ -f /tmp/bp-screen.pid ] && pid=$(cat /tmp/bp-screen.pid 2>/dev/null)
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    node /opt/bp/bp-screen.mjs "--live-url=$live" >>/tmp/bp-screen.log 2>&1 &
    echo $! >/tmp/bp-screen.pid
  fi
fi

# Token usage goes to the director while the run lasts; one reporter per pod.
if [ -n "$usage" ]; then
  pid=""
  [ -f /tmp/bp-usage.pid ] && pid=$(cat /tmp/bp-usage.pid 2>/dev/null)
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    node /opt/bp/bp-usage.mjs "--usage-url=$usage" >>/tmp/bp-usage.log 2>&1 &
    echo $! >/tmp/bp-usage.pid
  fi
fi

# A lead run has no browser: report usage, then serve an MCP server with no tools.
if [ -n "$usageonly" ]; then
  exec node /opt/bp/bp-null-mcp.mjs
fi

# Fetch the persona's test files into /workspace/files before the browser
# starts. Best effort and quick (10 s in total): a failure is logged (never
# the URL, it carries the run token) and the browser starts anyway. Each file
# lands as a .part and is moved into place only when complete. Output goes to
# the log, not stdout.
if [ -n "$files" ]; then
  timeout 10 sh -c '
    mkdir -p /workspace/files || exit 1
    list=$(curl -fsS --max-time 8 "$1") || { echo "bp-files: could not list files"; exit 1; }
    printf "%s" "$list" | node -e "
      let d=\"\"; process.stdin.on(\"data\",c=>d+=c).on(\"end\",()=>{
        try { for (const n of JSON.parse(d)) if (/^[a-z0-9][a-z0-9._-]{0,63}\$/.test(n)) console.log(n); } catch (e) { process.exit(1); }
      })" | while read -r n; do
      part="/workspace/files/.$n.part"
      if curl -fsS --max-time 8 -o "$part" "$1$n"; then mv -f "$part" "/workspace/files/$n"; else rm -f "$part"; echo "bp-files: could not fetch $n"; fi
    done
  ' sh "$files" >>/tmp/bp-files.log 2>&1 || echo "bp-files: failed or timed out" >>/tmp/bp-files.log
  rm -f /workspace/files/.*.part 2>/dev/null
fi

# Restore the persona's browser profile (cookies and site storage saved at
# the end of its last run). Best effort, 10 s: 204 means start empty, and any
# failure starts empty too. Kept outside /workspace/out and /workspace/files
# so it is never uploaded or attached. Playwright reads it when it opens the
# browser context, so the file stays for the life of the pod.
if [ -n "$profile" ]; then
  rm -f /workspace/profile.json /workspace/.profile.part
  code=$(curl -sS --max-time 10 -o /workspace/.profile.part -w '%{http_code}' "$profile" 2>>/tmp/bp-profile.log)
  if [ "$code" = "200" ] && [ -s /workspace/.profile.part ]; then
    mv -f /workspace/.profile.part /workspace/profile.json
    set -- "$@" "--storage-state=/workspace/profile.json"
  else
    rm -f /workspace/.profile.part
    [ "$code" = "204" ] || echo "bp-profile: no profile restored (HTTP $code)" >>/tmp/bp-profile.log
  fi
fi

# tiny's egress proxy, when on, arrives as HTTPS_PROXY/NO_PROXY. Hand it to
# Chromium explicitly rather than rely on Chromium reading the environment,
# so every page request goes through the fence and its refusals are logged.
proxy="${HTTPS_PROXY:-$https_proxy}"
if [ -n "$proxy" ]; then
  set -- "$@" "--proxy-server=$proxy"
  bypass="${NO_PROXY:-$no_proxy}"
  [ -n "$bypass" ] && set -- "$@" "--proxy-bypass=$bypass"
fi

name=""
case "$device" in
  "") ;;
  iphone-15) name="iPhone 15" ;;
  iphone-15-pro-max) name="iPhone 15 Pro Max" ;;
  pixel-7) name="Pixel 7" ;;
  galaxy-s24) name="Galaxy S24" ;;
  ipad) name="iPad (gen 11)" ;;
  ipad-mini) name="iPad Mini" ;;
  *) echo "bp-browser: ignoring unknown --bp-device value" >&2 ;;
esac

if [ -n "$name" ]; then
  exec playwright-mcp --config /opt/bp/pw-config.json "$@" "--device=$name"
fi
exec playwright-mcp --config /opt/bp/pw-config.json "$@"
